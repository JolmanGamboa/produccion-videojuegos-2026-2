[gd_resource type="Theme" load_steps=7 format=3]

; Tema visual unificado de la Biblioteca Interactiva 2D (Laboratorio 7).
; Registrado como tema por defecto del proyecto en project.godot
; (gui/theme/custom), de modo que las cinco pantallas heredan la misma
; tipografía, los mismos botones y los mismos paneles sin repetir overrides
; escena por escena. La paleta es cálida y oscura, con un acento de latón.
;
;   fondo #1A1512 · superficie #241D18 · borde #3A2F26
;   texto #EFE6DA · texto suave #B3A491 · acento #C08A3E

