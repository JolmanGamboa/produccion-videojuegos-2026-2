sinopsis = "En el planeta desértico Arrakis, única fuente de la especia que permite el viaje interestelar, la casa Atreides queda atrapada en una guerra por el control del recurso más valioso del universo conocido."

[sub_resource type="Resource" id="Resource_0o7kc"]
