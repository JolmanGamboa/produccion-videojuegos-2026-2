[gd_scene format=3]

[ext_resource type="Script" path="res://src/scenes/simulation/step_1_base.gd" id="1_step_1"]
[ext_resource type="PackedScene" path="res://src/components/navigation/button_nav.tscn" id="2_button_nav"]
[ext_resource type="Theme" path="res://src/assets/ui/ui_theme.tres" id="3_theme"]
[ext_resource type="Texture2D" path="res://src/assets/ui/icons/ic_cerrar.png" id="4_ic_cerrar"]
[ext_resource type="Texture2D" path="res://src/assets/ui/icons/ic_volver.png" id="5_ic_volver"]

[node name="Step1Base" type="Control"]
theme = ExtResource("3_theme")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_step_1")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 26
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 26

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LblTitulo" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"TituloPantalla"
text = "Sala de lectura"
horizontal_alignment = 1

[node name="LblEstante" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"SubtituloPantalla"
text = "Elige un ejemplar del estante"
horizontal_alignment = 1
autowrap_mode = 3

[node name="ScrollEstante" type="ScrollContainer" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 170)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="GridLibros" type="GridContainer" parent="MarginContainer/VBoxContainer/ScrollEstante"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
columns = 3

[node name="FichaLibro" type="PanelContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3

[node name="MarginFicha" type="MarginContainer" parent="MarginContainer/VBoxContainer/FichaLibro"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 14

[node name="VBoxFicha" type="VBoxContainer" parent="MarginContainer/VBoxContainer/FichaLibro/MarginFicha"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LblLibro" type="Label" parent="MarginContainer/VBoxContainer/FichaLibro/MarginFicha/VBoxFicha"]
layout_mode = 2
theme_type_variation = &"TituloFicha"
text = "Ningún libro abierto"
autowrap_mode = 3

[node name="LblDatos" type="Label" parent="MarginContainer/VBoxContainer/FichaLibro/MarginFicha/VBoxFicha"]
layout_mode = 2
theme_type_variation = &"EtiquetaSeccion"
text = ""
autowrap_mode = 3

[node name="LblSinopsis" type="Label" parent="MarginContainer/VBoxContainer/FichaLibro/MarginFicha/VBoxFicha"]
layout_mode = 2
text = "Selecciona un libro del estante para leer su descripción."
autowrap_mode = 3

[node name="LblEstado" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Abre un libro y elige su plazo de préstamo."
horizontal_alignment = 1
autowrap_mode = 3

[node name="LblPlazos" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"EtiquetaSeccion"
text = "Plazo de préstamo"
horizontal_alignment = 1

[node name="PlazosContainer" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BtnPlazoDiario" type="Button" parent="MarginContainer/VBoxContainer/PlazosContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
size_flags_horizontal = 3
disabled = true
text = "Diario (1 día)"

[node name="BtnPlazoQuincenal" type="Button" parent="MarginContainer/VBoxContainer/PlazosContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
size_flags_horizontal = 3
disabled = true
text = "Quincenal (15 días)"

[node name="BtnPlazoMensual" type="Button" parent="MarginContainer/VBoxContainer/PlazosContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
size_flags_horizontal = 3
disabled = true
text = "Mensual (30 días)"

[node name="BtnCerrar" type="Button" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
disabled = true
icon = ExtResource("4_ic_cerrar")
text = "Devolver el ejemplar al estante"

[node name="LblTotal" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"TotalDestacado"
text = "Días comprometidos en préstamo: 0"
horizontal_alignment = 1

[node name="BtnVolver" parent="MarginContainer/VBoxContainer" instance=ExtResource("2_button_nav")]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
icon = ExtResource("5_ic_volver")
text = "Volver a los estantes"
target_scene = "res://src/scenes/categories/categories_panel.tscn"
discard_previous = true
