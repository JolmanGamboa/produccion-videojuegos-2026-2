[gd_scene format=3]

[ext_resource type="Script" path="res://src/scenes/simulation/step_1_base.gd" id="1_step_1"]
[ext_resource type="PackedScene" path="res://src/components/navigation/button_nav.tscn" id="2_button_nav"]
[ext_resource type="Theme" path="res://src/assets/ui/ui_theme.tres" id="3_theme"]
[ext_resource type="Texture2D" path="res://src/assets/ui/icons/ic_volver.png" id="5_ic_volver"]

[node name="Step1Base" type="Control"]
theme = ExtResource("3_theme")
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_step_1")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 26
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 26

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LblTitulo" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"TituloPantalla"
text = "Sala de lectura"
horizontal_alignment = 1

[node name="LblEstante" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"SubtituloPantalla"
text = "Elige un ejemplar del estante"
horizontal_alignment = 1
autowrap_mode = 3

[node name="ScrollEstante" type="ScrollContainer" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ListaLibros" type="VBoxContainer" parent="MarginContainer/VBoxContainer/ScrollEstante"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="LblEstado" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Abre un ejemplar y elige su plazo de préstamo."
horizontal_alignment = 1
autowrap_mode = 3

[node name="LblTotal" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"TotalDestacado"
text = "Días comprometidos en préstamo: 0"
horizontal_alignment = 1

[node name="BtnVolver" parent="MarginContainer/VBoxContainer" instance=ExtResource("2_button_nav")]
custom_minimum_size = Vector2(0, 42)
layout_mode = 2
icon = ExtResource("5_ic_volver")
text = "Volver a los estantes"
target_scene = "res://src/scenes/categories/categories_panel.tscn"
discard_previous = true
